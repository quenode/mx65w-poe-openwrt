#!/bin/sh
# First-boot network defaults for the Meraki MX65 / MX65W.
#
# Runs once, from /etc/uci-defaults, and is deleted immediately afterwards by
# OpenWrt. Everything below is guarded so a re-flash over an existing
# configuration cannot silently rewrite a working network.

STOCK_LAN="192.168.1.1"
LAN_ADDR="192.168.88.1"
LAN_NETMASK="255.255.255.0"

# Static lease for the PoE access point on lan11.
# Remove or edit this block if the AP is replaced.
AP_MAC="00:0B:82:A8:45:A4"
AP_IP="192.168.88.238"

current_lan=$(uci -q get network.lan.ipaddr)

# Only act on a stock, unconfigured install. If the LAN address is already
# something else the operator has set it deliberately and we must not touch it.
if [ -n "$current_lan" ] && [ "$current_lan" != "$STOCK_LAN" ]; then
	exit 0
fi

uci -q batch <<EOF
set network.lan.proto='static'
set network.lan.ipaddr='$LAN_ADDR'
set network.lan.netmask='$LAN_NETMASK'

set dhcp.lan.start='100'
set dhcp.lan.limit='150'
set dhcp.lan.leasetime='12h'

set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device='br-wan'
EOF

# The stock image exposes WAN on the bridge in some board definitions; make
# sure only br-wan carries the wan interface.
uci -q delete network.wan6

# LAN zone accepts admin input so LuCI and SSH work from inside; WAN zone
# masquerades so LAN clients get outbound connectivity.
uci -q set firewall.@zone[0].name='lan'
uci -q set firewall.@zone[0].input='ACCEPT'
uci -q set firewall.@zone[0].output='ACCEPT'
uci -q set firewall.@zone[0].forward='ACCEPT'
uci -q set firewall.@zone[1].name='wan'
uci -q set firewall.@zone[1].input='REJECT'
uci -q set firewall.@zone[1].output='ACCEPT'
uci -q set firewall.@zone[1].forward='REJECT'
uci -q set firewall.@zone[1].masq='1'
uci -q set firewall.@zone[1].mtu_fix='1'

# Pin the access point so its address stays predictable.
if [ -n "$AP_MAC" ] && ! uci -q get dhcp.@host[0].mac | grep -qi "$AP_MAC"; then
	uci -q add dhcp host
	uci -q set dhcp.@host[-1].name='poe-ap'
	uci -q set dhcp.@host[-1].mac="$AP_MAC"
	uci -q set dhcp.@host[-1].ip="$AP_IP"
fi

uci -q commit network
uci -q commit dhcp
uci -q commit firewall

exit 0